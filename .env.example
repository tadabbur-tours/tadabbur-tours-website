# Stripe Configuration
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
STRIPE_SECRET_KEY=sk_test_your_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Contact form (Brevo) – server-side only, no keys in frontend
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=noreply@yourdomain.com
BREVO_SENDER_NAME=Tadabbur Tours
CONTACT_BUSINESS_EMAIL=info@tadabburtours.com
# Optional: send confirmation email to user after submit
# CONTACT_SEND_CONFIRMATION=true
# Optional: add contacts to a Brevo list (numeric ID from Brevo dashboard)
# BREVO_LIST_ID=2

# Optional: comma-separated access codes (case-insensitive) that unlock three equal installments
# for the January extended package only (see BOOKING_THREE_INSTALLMENT_COUPONS usage in repo).
# BOOKING_THREE_INSTALLMENT_COUPONS=CODE1,CODE2

# Optional: Add other environment variables as needed
# NODE_ENV=development
# PORT=3000
